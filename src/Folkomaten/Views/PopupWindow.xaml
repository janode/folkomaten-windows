<Window x:Class="Folkomaten.Views.PopupWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Folkomaten.ViewModels"
        Title="Folkomaten"
        Width="400" Height="480"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual"
        ShowInTaskbar="False" Topmost="True"
        Deactivated="OnDeactivated" PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- En knapp uten ramme: bare en diskret fyllfarge ved hover. -->
        <Style x:Key="PlainButton" TargetType="ButtonBase">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Fast glyfbredde, så stegnumrene står på linje uansett glyf. -->
        <Style x:Key="StepGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <DataTemplate DataType="{x:Type vm:UserRowViewModel}">
            <Border x:Name="Row" Background="Transparent" Padding="12,8" Cursor="Hand"
                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    MouseLeftButtonUp="OnRowClicked">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource PlainButton}" Click="OnFavoriteClicked"
                            ToolTip="{Binding FavoriteToolTip}" AutomationProperties.Name="{Binding FavoriteToolTip}">
                        <TextBlock x:Name="Star" Style="{StaticResource Glyph}" Text="&#xE734;"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Button>

                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding User.FullName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding User.Fnr}" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="·" Margin="6,0" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding User.BirthDateFormatted}" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource PlainButton}" Click="OnCopyClicked"
                            ToolTip="Kopier fødselsnummer" AutomationProperties.Name="Kopier fødselsnummer">
                        <TextBlock x:Name="CopyGlyph" Style="{StaticResource Glyph}" Text="&#xE8C8;"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter TargetName="Star" Property="Text" Value="&#xE735;" />
                    <Setter TargetName="Star" Property="Foreground" Value="Goldenrod" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCopied}" Value="True">
                    <Setter TargetName="CopyGlyph" Property="Text" Value="&#xE73E;" />
                    <Setter TargetName="CopyGlyph" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Søk og filter -->
            <StackPanel Margin="10">
                <Grid>
                    <TextBox x:Name="SearchBox" Padding="30,6,30,6" AutomationProperties.Name="Søk navn eller fødselsnummer"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Margin="10,0,0,0" FontSize="13"
                               HorizontalAlignment="Left" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Søk navn eller fødselsnummer" Margin="32,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Search}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button HorizontalAlignment="Right" Margin="0,0,4,0" Click="OnClearSearchClicked" ToolTip="Tøm søk" AutomationProperties.Name="Tøm søk">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PlainButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Search}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Button>
                </Grid>

                <UniformGrid Columns="2" Margin="0,8,0,0">
                    <RadioButton Style="{DynamicResource {x:Type ToggleButton}}" GroupName="Filter" Content="Alle"
                                 IsChecked="True" HorizontalAlignment="Stretch" Margin="0,0,2,0" />
                    <RadioButton Style="{DynamicResource {x:Type ToggleButton}}" GroupName="Filter" Content="Favoritter"
                                 IsChecked="{Binding OnlyFavorites}" HorizontalAlignment="Stretch" Margin="2,0,0,0" />
                </UniformGrid>
            </StackPanel>

            <!-- Liste, eller en tom tilstand -->
            <Border Grid.Row="1" BorderThickness="0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Rows}" />
                    </ScrollViewer>
                    <StackPanel VerticalAlignment="Center" Margin="24,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRows}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding EmptyStateGlyph}" FontSize="32"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding EmptyStateText}" Margin="0,8,0,0" TextAlignment="Center"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Nye testbrukere: hent, bestill, last inn -->
            <StackPanel Grid.Row="2" Margin="10,6">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Click="OnMoreClicked"
                            ToolTip="Flere valg for lista" AutomationProperties.Name="Flere valg for lista">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE712;"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Last inn eksempelbrukere" Click="OnLoadEmbeddedClicked"
                                          Visibility="{Binding CanLoadEmbedded, Converter={StaticResource BoolToVisibility}}" />
                                <MenuItem Header="Tøm liste" Click="OnClearListClicked" IsEnabled="{Binding CanClear}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <ToggleButton Style="{StaticResource PlainButton}" HorizontalAlignment="Left"
                                  IsChecked="{Binding ShowDataActions}" AutomationProperties.Name="Nye testbrukere"
                                  ToolTip="Hent og bestill nye testbrukere – sjelden nødvendig">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="9" Margin="0,0,6,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                        <Setter Property="Text" Value="&#xE76C;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowDataActions}" Value="True">
                                                <Setter Property="Text" Value="&#xE70D;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Nye testbrukere" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ToggleButton>
                </DockPanel>

                <StackPanel Margin="0,4,0,2" HorizontalAlignment="Left"
                            Visibility="{Binding ShowDataActions, Converter={StaticResource BoolToVisibility}}">
                    <Button Click="OnFetchClicked" HorizontalContentAlignment="Left" AutomationProperties.Name="{Binding FetchLabel}"
                            ToolTip="Hent testbrukere fra Tenor som finnes i syntetisk folkeregister">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PlainButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFetchingFromTenor}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource StepGlyph}" Text="&#xE896;" />
                            <TextBlock Text="{Binding FetchLabel}" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="10 brukere" Tag="10" Click="OnFetchCountClicked" />
                                <MenuItem Header="25 brukere" Tag="25" Click="OnFetchCountClicked" />
                                <MenuItem Header="50 brukere" Tag="50" Click="OnFetchCountClicked" />
                                <MenuItem Header="100 brukere" Tag="100" Click="OnFetchCountClicked" />
                                <Separator />
                                <MenuItem Header="Innstillinger…" Click="OnSettingsClicked" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource PlainButton}" Click="OnOrderClicked" HorizontalContentAlignment="Left" AutomationProperties.Name="2. Koble til BankID"
                            ToolTip="Åpne BankID preprod (bulk-order) og last opp fila. Brukerne virker først etter at de er bestilt der.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource StepGlyph}" Text="&#xE8A7;" />
                            <TextBlock Text="2. Koble til BankID" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PlainButton}" Click="OnLoadFileClicked" HorizontalContentAlignment="Left" AutomationProperties.Name="3. Last inn i appen"
                            ToolTip="Velg den bestilte fila og ta den i bruk i appen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource StepGlyph}" Text="&#xE8B5;" />
                            <TextBlock Text="3. Last inn i appen" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Bunntekst -->
            <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <Grid Margin="10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Content="Start ved innlogging" IsChecked="{Binding StartAtLogin}"
                              ToolTip="La appen starte automatisk når du logger inn" />
                    <TextBlock Grid.Column="1" Text="{Binding ResultCount}" ToolTip="{Binding SourceName}" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button Grid.Column="2" Style="{StaticResource PlainButton}" Click="OnSettingsClicked"
                            ToolTip="Innstillinger – Maskinporten og hurtigtast" AutomationProperties.Name="Innstillinger">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" />
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource PlainButton}" Click="OnExitClicked" Margin="4,0,0,0" AutomationProperties.Name="Avslutt">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;" Margin="0,0,6,0" />
                            <TextBlock Text="Avslutt" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
